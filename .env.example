# DeepResearch Studio 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置（对话模型，OpenAI 兼容协议）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Embedding 配置（本地向量知识库入库与检索共用，走同一 OpenAI 兼容服务）
# 百炼平台可用 text-embedding-v3；换其他服务时同步修改模型名
EMBEDDING_MODEL=text-embedding-v3

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# 本地向量知识库配置
# 向量库根目录，app/data/vector_store 下每个子目录为一个知识库集合
VECTOR_STORE_DIR=app/data/vector_store

# 会话检查点配置
# sqlite: 持久化到 CHECKPOINTER_DB，重启后可按 thread_id 恢复会话（推荐）
# memory: 仅内存，重启丢失，供本地调试使用
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_DB=app/data/checkpoints.db

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepresearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
