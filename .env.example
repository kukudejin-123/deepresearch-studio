# DeepResearch Studio 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置（对话模型，OpenAI 兼容协议）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Embedding 配置（本地向量知识库入库与检索共用，走同一 OpenAI 兼容服务）
# 百炼平台可用 text-embedding-v3；换其他服务时同步修改模型名
EMBEDDING_MODEL=text-embedding-v3

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# 本地向量知识库配置
# 向量库根目录，app/data/vector_store 下每个子目录为一个知识库集合
VECTOR_STORE_DIR=app/data/vector_store

# 会话检查点配置
# sqlite:   持久化到 CHECKPOINTER_DB，单机推荐
# postgres: 连接 PostgreSQL，多 worker 共享会话状态（arq 模式推荐，
#           需安装可选依赖: uv sync --extra postgres）
# memory:   仅内存，重启丢失，供本地调试使用
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_DB=app/data/checkpoints.db
CHECKPOINTER_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/deepresearch

# 任务队列配置（第二期可靠执行）
# memory: 进程内 asyncio 后台任务（默认，单机/开发）
# arq:   Redis + arq 分布式队列，需单独启动 worker:
#        uv run arq app.worker.tasks.WorkerSettings
TASK_QUEUE=memory
TASK_QUEUE_REDIS_URL=redis://127.0.0.1:6379/0

# 事件持久化（第二期）：执行事件落库，支持断线回放
EVENT_DB=app/data/events.db

# 用户认证配置（第一期安全改造）
# AUTH_ENABLED=false 时退化为单一开发用户，无需登录即可调试（不推荐生产使用）
AUTH_ENABLED=true
# JWT 签名密钥：生产环境必须修改为足够长的随机字符串（建议 32 字节以上）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=请改成足够长的随机密钥
# 访问令牌有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440
# 用户数据库路径（SQLite）
AUTH_DB=app/data/users.db

# 上传安全配置
# 单文件大小上限（MB）
UPLOAD_MAX_MB=20
# 允许的上传文件类型（逗号分隔）
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.md,.txt,.xlsx,.xls,.csv

# 接口限流配置
# 任务提交：每用户 N 次 / M 秒（防止 LLM 费用被打爆）
TASK_RATE_LIMIT=10
TASK_RATE_WINDOW_SECONDS=60
# 登录：每 IP+用户名 N 次 / M 秒（缓解暴力破解）
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepresearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
